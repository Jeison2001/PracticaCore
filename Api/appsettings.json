{
  "ConnectionStrings": {
    "Default": "Host=YOUR_DB_HOST;Port=5432;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Pooling=true;Minimum Pool Size=5;Connection Idle Lifetime=300;Keepalive=30;",
    "Hangfire": "Host=YOUR_DB_HOST;Port=5432;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;"
  },
  "App": {
    "FrontendUrl": "https://your-frontend-domain.example.com"
  },
  "AllowedOrigins": [
    "https://your-frontend-domain.example.com",
    "http://localhost:4200"
  ],
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "CHANGE_ME_STRONG_SECRET_KEY_MINIMUM_32_CHARACTERS",
    "Issuer": "PracticaCore.Api",
    "Audience": "PracticaCore.Clients",
    "ExpireMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "MaxActiveSessions": 2
  },
  "Authentication": {
    "Providers": [
      "google",
      "azure"
    ],
    "AllowedDomains": [
      "unicesar.edu.co"
    ],
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "HostedDomain": "unicesar.edu.co",
      "AllowedDomains": [
        "unicesar.edu.co"
      ]
    },
    "AzureAd": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "common",
      "ClientId": "YOUR_AZURE_CLIENT_ID",
      "AllowedTenantIds": [],
      "AllowedDomains": [
        "unicesar.edu.co"
      ]
    },
    "Register": {
      "AllowedDomains": [
        "unicesar.edu.co"
      ]
    }
  },
  "FileStorage": {
    "Provider": "local",
    "LocalPath": "Uploads",
    "GoogleCloud": {
      "BucketName": "YOUR_GCS_BUCKET_NAME",
      "ProjectId": "YOUR_GCP_PROJECT_ID",
      "CredentialsPath": "PATH_TO_SERVICE_ACCOUNT_JSON"
    },
    "AzureBlob": {
      "ConnectionString": "YOUR_AZURE_BLOB_CONNECTION_STRING",
      "ContainerName": "files",
      "BaseUrl": "https://yourstorageaccount.blob.core.windows.net/files"
    }
  },
  "EmailNotification": {
    "Provider": "SMTP",
    "SmtpSettings": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "YOUR_SMTP_EMAIL@example.com",
      "Password": "YOUR_SMTP_APP_PASSWORD",
      "EnableSsl": true,
      "DefaultFrom": "YOUR_SMTP_EMAIL@example.com",
      "DefaultFromName": "SIGEPRO · Universidad Popular del Cesar"
    }
  },
  "Hangfire": {
    "SchemaName": "hangfire",
    "Dashboard": {
      "User": "YOUR_HANGFIRE_USER",
      "Password": "YOUR_HANGFIRE_PASSWORD"
    }
  },
  "SlaAlerts": {
    "Enabled": true,
    "Cron": "30 7 * * *",
    "EvaluatorWarningBusinessDays": 20,
    "EvaluatorOverdueBusinessDays": 25,
    "CommitteeOverdueBusinessDays": 10,
    "StudentObservationsBusinessDays": 15,
    "DefenseReminderHours": 48,
    "WarnOnLastAllowedPeriod": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
